# Copy this file to .env if you need to override a default.
# Both variables are optional — the app works with none of them set.

# Where the Vite dev server proxies /api requests to. Only needed if your
# backend isn't running on the default http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3000

# Overrides the API base URL used by the browser at runtime. Leave unset
# for both local dev (the proxy above handles it) and the production
# Docker build (the API is served from the same origin as the frontend).
# VITE_API_BASE_URL=https://api.example.com
