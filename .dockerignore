# Dependencies (installed fresh inside the image)
**/node_modules

# Build output (rebuilt inside the image)
client/dist
server/public

# Secrets — never bake these into an image
.env
**/.env
!.env.example
!**/.env.example

# Version control / editor / OS cruft
.git
.gitignore
**/.DS_Store
.vscode
.idea

# Docs not needed at runtime
README.md
**/*.md

# Logs
**/npm-debug.log*
**/*.log
