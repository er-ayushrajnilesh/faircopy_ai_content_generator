# Used when running the built Docker image, e.g.:
#   docker run --env-file .env -p 3000:3000 ai-content-generator
#
# For local (non-Docker) development, use server/.env and, optionally,
# client/.env instead — see README.md.

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
PORT=3000
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=30
PROMPT_MAX_LENGTH=4000
