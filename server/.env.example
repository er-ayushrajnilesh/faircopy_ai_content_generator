# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Required. Your free Gemini API key from Google AI Studio
# (https://aistudio.google.com/apikey) — no billing required.
GEMINI_API_KEY=your-key-here

# Optional. Any Gemini model available on the Developer API.
# gemini-3.6-flash (default) is Google's current Flash-tier workhorse
# model and a strong all-round choice. Note that newly-created API keys
# are blocked from the older gemini-2.5 model family, so gemini-3.6-flash
# (or another 3.x model) is required for new keys. gemini-3.5-flash-lite
# is the fastest/cheapest option.
GEMINI_MODEL=gemini-3.6-flash

# Optional. How long to wait for the AI service before giving up, in ms.
GEMINI_TIMEOUT_MS=60000

# Optional. Port the Express server listens on.
PORT=3000

# Optional. development | production. Set to "production" by the Dockerfile.
NODE_ENV=development

# Optional. Comma-separated list of extra origins allowed to call the API
# cross-origin. Not needed for the default same-origin Docker deployment.
# ALLOWED_ORIGINS=https://example.com

# Optional. Rate limit for POST /api/generate.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=30

# Optional. Maximum accepted prompt length, in characters.
PROMPT_MAX_LENGTH=4000
